<IfModule mod_php5.c>
php_value memory_limit 256M
php_value max_execution_time 300
</IfModule>

# AddHandler application/x-httpd-ea-php56 .php

ErrorDocument 404 /404.php

RewriteEngine On

RewriteCond %{HTTP_HOST} localhost [NC]
RewriteCond %{REQUEST_URI} ^/yesautomation-git-new/(.*)$
RewriteRule ^ http://yesautomation-git-new.local/%1 [R=302,L]

RewriteCond %{HTTP_HOST} ^www\.localhost [NC]
RewriteRule ^(.*)$ http://yesautomation-git-new.local/$1 [R=302,L]

# Keep HTTPS/www redirects on the live domain only
RewriteCond %{HTTP_HOST} !localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
RewriteCond %{HTTP_HOST} !\.local$ [NC]
RewriteCond %{HTTP_HOST} !\.test$ [NC]
RewriteCond %{HTTPS} off
RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} !localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
RewriteCond %{HTTP_HOST} !\.local$ [NC]
RewriteCond %{HTTP_HOST} !\.test$ [NC]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule .* https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_URI} ^/404/$
RewriteRule ^(.*)$ /404.php [L]



# ErrorDocument 404 /404.html

# Redirect 301 /?fbclid=IwAR2XrQ7...OeIWsd5AgaSKCU6BE https://www.yesautomation.ae

